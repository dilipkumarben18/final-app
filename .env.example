# PostgreSQL connection string
# Local example:      postgresql://postgres:password@localhost:5432/saree_app
# Supabase/Railway/Neon will give you a connection string to paste here.
DATABASE_URL="postgresql://postgres:password@localhost:5432/saree_app"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"

# Supabase Storage (damage photos) - project Settings > API in the Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY is server-only, never expose it to the client.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="damage-photos"
